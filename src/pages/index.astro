  <!-- Floating Toast Notification -->
  <div
    id="toast"
    role="status"
    aria-live="polite"
    class="fixed bottom-6 right-6 z-50 transform translate-y-24 opacity-0 pointer-events-none transition-all duration-300 ease-out flex items-center gap-3 px-4 py-3 bg-zinc-900 text-white border border-emerald-500/40 shadow-2xl shadow-emerald-950/60 rounded-xl"
  >
    <div class="h-7 w-7 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
      </svg>
    </div>
    <div class="text-xs">
      <div id="toast-title" class="font-semibold text-zinc-100">¡Código copiado al portapapeles!</div>
      <div id="toast-desc" class="text-zinc-400">Listo para pegar en ChatGPT o Claude.</div>
    </div>
  </div>
</Layout>

<script>
  import { minifyCode, calculateStats, detectLanguage, type SupportedLanguage } from '../utils/minifier';

  // DOM Elements
  const inputCodeEl = document.getElementById('input-code') as HTMLTextAreaElement;
  const outputCodeEl = document.getElementById('output-code') as HTMLTextAreaElement;

  const statOriginalTokens = document.getElementById('stat-original-tokens') as HTMLElement;
  const statOriginalChars = document.getElementById('stat-original-chars') as HTMLElement;
  const statMinifiedTokens = document.getElementById('stat-minified-tokens') as HTMLElement;
  const statMinifiedChars = document.getElementById('stat-minified-chars') as HTMLElement;
  const statReductionPct = document.getElementById('stat-reduction-pct') as HTMLElement;
  const statTokensSaved = document.getElementById('stat-tokens-saved') as HTMLElement;
  const statSavedDollars = document.getElementById('stat-saved-dollars') as HTMLElement;
  const statSavedProjection = document.getElementById('stat-saved-projection') as HTMLElement;

  const leftLinesCount = document.getElementById('left-lines-count') as HTMLElement;
  const leftCharsCount = document.getElementById('left-chars-count') as HTMLElement;
  const rightLinesCount = document.getElementById('right-lines-count') as HTMLElement;
  const rightCharsCount = document.getElementById('right-chars-count') as HTMLElement;
  const rightTokensBadge = document.getElementById('right-tokens-badge') as HTMLElement;

  const optComments = document.getElementById('opt-comments') as HTMLInputElement;
  const optWhitespace = document.getElementById('opt-whitespace') as HTMLInputElement;
  const optBlanklines = document.getElementById('opt-blanklines') as HTMLInputElement;

  const langButtons = document.querySelectorAll<HTMLButtonElement>('.lang-btn');
  const detectedBadge = document.getElementById('detected-badge') as HTMLElement;

  const btnCopy = document.getElementById('btn-copy') as HTMLButtonElement;
  const copyText = document.getElementById('copy-text') as HTMLElement;
  const btnPaste = document.getElementById('btn-paste') as HTMLButtonElement;
  const btnSample = document.getElementById('btn-sample') as HTMLButtonElement;
  const btnClear = document.getElementById('btn-clear') as HTMLButtonElement;

  const toast = document.getElementById('toast') as HTMLElement;
  const toastTitle = document.getElementById('toast-title') as HTMLElement;
  const toastDesc = document.getElementById('toast-desc') as HTMLElement;

  let currentLanguage: SupportedLanguage = 'auto';
  let toastTimeout: number | undefined;

  // Sample code snippets for quick demonstration
  const sampleCodes: Record<string, string> = {
    javascript: `// ==========================================
// Módulo de Validación y Descuentos
// ==========================================

/**
 * Calcula el total con impuestos y descuentos
 * @param {Array<Object>} items - Lista de productos comprados
 * @param {Object} customer - Información del cliente
 * @returns {Object} Resumen financiero
 */
function processCheckout(items, customer) {
    // 1. Verificación preliminar de integridad
    if (!items || items.length === 0) {
        console.warn("La cesta se encuentra vacía");
        return { total: 0, status: "EMPTY" };
    }

    let subtotal = 0;

    /* Iterar cada producto para sumar subtotales
       aplicando el precio base y la cantidad solicitada */
    for (const item of items) {
        subtotal += item.price * item.quantity;
    }

    // Comprobar si califica para descuento VIP (20% OFF)
    let discount = 0;
    if (customer && customer.membership === "VIP") {
        discount = subtotal * 0.20; // 20% descuento
    }

    const tax = (subtotal - discount) * 0.16; // IVA 16%
    const finalAmount = subtotal - discount + tax;

    // Retorno de estructura limpia
    return {
        subtotal,
        discount,
        tax,
        total: finalAmount
    };
}`,
    python: `# ==========================================
# Servicio de Procesamiento de Datos LLM
# ==========================================

import os
import json

class PromptOptimizer:
    """Clase responsable de preparar payloads para APIs de LLM."""

    def __init__(self, api_key: str):
        # Inicializar credenciales y configuración
        self.api_key = api_key
        self.default_model = "gpt-4o"

    def format_payload(self, system_instruction: str, user_query: str) -> dict:
        # Validación de parámetros
        if not user_query.strip():
            raise ValueError("Query no puede estar vacía")

        # Construir estructura del mensaje
        payload = {
            "model": self.default_model,
            "messages": [
                {"role": "system", "content": system_instruction},
                {"role": "user", "content": user_query}
            ],
            "temperature": 0.2
        }

        # Retornar objeto serializable
        return payload
`,
    json: `{
  // Configuración de la aplicación
  "app": {
    "name": "TokenDiet",
    "version": "1.0.0",
    "environment": "production"
  },
  /* Lista de proveedores soportados */
  "providers": [
    {
      "id": "openai",
      "model": "gpt-4o",
      "ratePerMillion": 5.00
    },
    {
      "id": "anthropic",
      "model": "claude-3-5-sonnet",
      "ratePerMillion": 3.00
    }
  ]
}`,
    html: `<!DOCTYPE html>
<html lang="es">
<head>
    <!-- Metadatos de la página -->
    <meta charset="UTF-8">
    <title>TokenDiet Demo</title>
</head>
<body>
    <!-- Barra de navegación principal -->
    <header class="navbar">
        <h1>TokenDiet Optimizer</h1>
    </header>
    
    <main>
        <p>Ahorra tokens en tus prompts de IA.</p>
    </main>
</body>
</html>`
  };

  /**
   * Main function to process input and update UI metrics.
   */
  function handleMinification(): void {
    const rawInput = inputCodeEl.value;

    const detected = detectLanguage(rawInput);
    if (currentLanguage === 'auto') {
      detectedBadge.textContent = `detectado: ${detected}`;
    } else {
      detectedBadge.textContent = `fijado: ${currentLanguage}`;
    }

    const minified = minifyCode(rawInput, {
      language: currentLanguage,
      removeComments: optComments.checked,
      collapseWhitespace: optWhitespace.checked,
      removeBlankLines: optBlanklines.checked,
      preservePythonIndent: true,
    });

    outputCodeEl.value = minified;

    // Calculate metrics
    const stats = calculateStats(rawInput, minified);

    // Update Dashboard Cards
    statOriginalTokens.textContent = stats.originalTokens.toLocaleString();
    statOriginalChars.textContent = stats.originalChars.toLocaleString();

    statMinifiedTokens.textContent = stats.minifiedTokens.toLocaleString();
    statMinifiedChars.textContent = stats.minifiedChars.toLocaleString();

    statReductionPct.textContent = `${stats.reductionPercentage}%`;
    statTokensSaved.textContent = `(-${stats.tokensSaved.toLocaleString()} tkn)`;

    statSavedDollars.textContent = stats.savedDollars.toFixed(4);
    statSavedProjection.textContent = `$${(stats.savedDollars * 1000).toFixed(2)}`;

    // Update panel footers
    const leftLines = rawInput ? rawInput.split('\n').length : 0;
    const rightLines = minified ? minified.split('\n').length : 0;

    leftLinesCount.textContent = `${leftLines} ${leftLines === 1 ? 'línea' : 'líneas'}`;
    leftCharsCount.textContent = `${stats.originalChars} caracteres`;

    rightLinesCount.textContent = `${rightLines} ${rightLines === 1 ? 'línea' : 'líneas'}`;
    rightCharsCount.textContent = `${stats.minifiedChars} caracteres`;
    rightTokensBadge.textContent = `${stats.minifiedTokens.toLocaleString()} tokens`;
  }

  /**
   * Display floating toast feedback.
   */
  function showToast(title: string, desc: string): void {
    if (toastTimeout) clearTimeout(toastTimeout);

    toastTitle.textContent = title;
    toastDesc.textContent = desc;

    toast.classList.remove('translate-y-24', 'opacity-0', 'pointer-events-none');
    toast.classList.add('translate-y-0', 'opacity-100');

    toastTimeout = window.setTimeout(() => {
      toast.classList.remove('translate-y-0', 'opacity-100');
      toast.classList.add('translate-y-24', 'opacity-0', 'pointer-events-none');
    }, 3200);
  }

  /**
   * Copy optimized code to clipboard.
   */
  async function copyToClipboard(): Promise<void> {
    const text = outputCodeEl.value;
    if (!text || text.trim().length === 0) {
      showToast('No hay código para copiar', 'Pega primero algo de código en el panel izquierdo.');
      return;
    }

    try {
      await navigator.clipboard.writeText(text);

      const originalText = copyText.textContent;
      copyText.textContent = '¡Copiado!';
      btnCopy.classList.add('ring-2', 'ring-emerald-300');

      const stats = calculateStats(inputCodeEl.value, text);
      showToast(
        '¡Código Copiado!',
        `Ahorraste ${stats.tokensSaved.toLocaleString()} tokens (${stats.reductionPercentage}% de reducción).`
      );

      setTimeout(() => {
        copyText.textContent = originalText;
        btnCopy.classList.remove('ring-2', 'ring-emerald-300');
      }, 2000);
    } catch {
      // Fallback
      outputCodeEl.select();
      document.execCommand('copy');
      showToast('¡Copiado al portapapeles!', 'Código listo para enviar a tu LLM.');
    }
  }

  /**
   * Paste from clipboard.
   */
  async function pasteFromClipboard(): Promise<void> {
    try {
      const text = await navigator.clipboard.readText();
      if (text) {
        inputCodeEl.value = text;
        handleMinification();
        showToast('Código pegado', 'Minificación aplicada automáticamente.');
      }
    } catch {
      inputCodeEl.focus();
      showToast('Permiso de portapapeles requerido', 'Presiona Ctrl+V para pegar manualmente.');
    }
  }

  // Event Listeners
  inputCodeEl.addEventListener('input', handleMinification);
  optComments.addEventListener('change', handleMinification);
  optWhitespace.addEventListener('change', handleMinification);
  optBlanklines.addEventListener('change', handleMinification);

  // Language buttons selector
  langButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      langButtons.forEach((b) => {
        b.classList.remove('active', 'bg-emerald-500/20', 'text-emerald-300', 'border-emerald-500/30');
        b.classList.add('text-zinc-400', 'border-transparent');
      });

      btn.classList.add('active', 'bg-emerald-500/20', 'text-emerald-300', 'border-emerald-500/30');
      btn.classList.remove('text-zinc-400', 'border-transparent');

      const lang = btn.getAttribute('data-lang') as SupportedLanguage;
      currentLanguage = lang || 'auto';
      handleMinification();
    });
  });

  // Action buttons
  btnCopy.addEventListener('click', copyToClipboard);
  btnPaste.addEventListener('click', pasteFromClipboard);

  btnClear.addEventListener('click', () => {
    inputCodeEl.value = '';
    handleMinification();
    inputCodeEl.focus();
    showToast('Contenido limpiado', 'El editor está listo para nuevo código.');
  });

  btnSample.addEventListener('click', () => {
    const langKey = currentLanguage === 'auto' ? 'javascript' : currentLanguage;
    const sample = sampleCodes[langKey] || sampleCodes.javascript;
    inputCodeEl.value = sample;
    handleMinification();
    showToast('Ejemplo cargado', `Demostración de código ${langKey.toUpperCase()} lista.`);
  });

  // Pre-load default sample on initial startup so user immediately sees real numbers!
  inputCodeEl.value = sampleCodes.javascript;
  handleMinification();
</script>
